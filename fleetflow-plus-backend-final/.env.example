# Server
PORT=6050
NODE_ENV=development
TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:6050

# Database
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_REVERIFY_SECRET=
JWT_REVERIFY_EXPIRES_IN=24h
# Use lax for localhost/same-site domains; none for cross-site HTTPS only.
COOKIE_SAME_SITE=lax

# Admin
ADMIN_NAME=FleetFlowAdmin
ADMIN_EMAIL=admin-fleetflow@yopmail.com
ADMIN_PASSWORD=
ADMIN_PHONE=

# Redis (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=fleetflow:

# OTP
OTP_SECRET=
OTP_EXPIRES_IN=60
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# Cloudinary (Part 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fleetflow
DEFAULT_PROFILE_IMAGE_URL=

# Email delivery: smtp locally and on Vercel; remote on Render Free
EMAIL_DELIVERY_MODE=smtp
EMAIL_RELAY_ENABLED=false
EMAIL_SERVICE_URL=
EMAIL_SERVICE_SECRET=

# Optional AMP email (requires approved/supported sender and HTTPS)
AMP_EMAIL_ENABLED=false
AMP_RESEND_BACKEND_URL=

# SMTP (local and Vercel only)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Socket.IO (Part 2)
SOCKET_PATH=/socket.io

# Razorpay (Future)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
